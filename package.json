{
  "name": "promo-monitor-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-charts": "^9.13.0",
    "@mui/x-date-pickers": "^9.13.0",
    "@supabase/supabase-js": "^2.116.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "dayjs": "^1.11.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
    "react-router-dom": "^6.30.1",
    "react-scripts": "5.0.1",
    "tesseract.js": "^7.0.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:seed": "node scripts/generate-seed.js && supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/supabase.ts"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-restricted-syntax": [
        "error",
        {
          "selector": "Literal[value=/—/]",
          "message": "Avoid em dashes in strings - use a hyphen (-) or rewrite the sentence."
        },
        {
          "selector": "JSXText[value=/—/]",
          "message": "Avoid em dashes in UI text - use a hyphen (-) or rewrite the sentence."
        },
        {
          "selector": "TemplateElement[value.raw=/—/]",
          "message": "Avoid em dashes in template strings - use a hyphen (-) or rewrite the sentence."
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.19"
  }
}
