# Deliberately unreachable (not the real local Supabase port) so tests
# always exercise AppContext's static-data fallback path deterministically,
# instead of silently depending on whether a local Supabase happens to be
# running on this machine.
REACT_APP_SUPABASE_URL=http://127.0.0.1:1
REACT_APP_SUPABASE_ANON_KEY=test-anon-key-not-real
