# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Local dev: run `npx supabase start`, then `npx supabase status` to get these.
# Cloud: get these from your Supabase project's Settings > API page.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Existing OCR feature (see src/utils/geminiOcr.ts). Move this behind a
# server-side function before deploying — a REACT_APP_ var is bundled into
# the client JS and visible to anyone who opens devtools.
REACT_APP_GEMINI_API_KEY=
